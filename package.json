{
  "name": "freedeck",
  "version": "0.3.0",
  "description": "Steam Deck game library, transfer and cloud-save management plugin",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GUIEROOR/Freedeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "freedeck",
    "steam-deck",
    "steamos"
  ],
  "author": "Panyiwei and contributors",
  "license": "LGPL-2.1",
  "bugs": {
    "url": "https://github.com/GUIEROOR/Freedeck/issues"
  },
  "homepage": "https://github.com/GUIEROOR/Freedeck#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
